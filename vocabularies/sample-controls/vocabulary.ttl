# Sample controls: controls used in place of a biological material.
# Generated by scripts/import_metatree_species.py; edit by pull request, see README.md.

@prefix controls: <https://w3id.org/fairgraph/vocab/sample-controls/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fs: <https://fairgraph.nl/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

controls:soil a fs:ControlSample ;
    rdfs:label "Soil" ;
    dcterms:replaces <https://sils.uva.nl/ontology#ctrlSOIL02> .

controls:unplanted-soil a fs:ControlSample ;
    rdfs:label "Unplanted soil control" ;
    dcterms:replaces <https://sils.uva.nl/ontology#ctrl001> .

